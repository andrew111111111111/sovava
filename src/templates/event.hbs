{{#each this}}
  <li class="event__item">
    <article class="event">
      <div class="event__photo">
        <img src="{{img}}" alt="{{name}}" />
      </div>
      <h2 class="event__title">{{name}}</h2>
      <p class="event__date">{{date}}</p>
      <p class="event__place">{{place}}</p>
    </article>
  </li>
{{/each}}